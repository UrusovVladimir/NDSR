FROM python:3.6.15-bullseye
# git уже есть в образе python:*-bullseye
RUN apt-get update && apt-get install -y --no-install-recommends telnet \
    && rm -rf /var/lib/apt/lists/* \
    && git clone https://github.com/UrusovVladimir/flask-remote-terminal.git
WORKDIR /flask-remote-terminal
RUN rm ./config_sample.py
# domain — хост MOXA без порта (moxa_ip, вычисляется из moxa_ips)
RUN printf '%s\n' \
    "TERM_INIT_CONFIG = {" \
    "    'domain': '{{ moxa_ip }}'," \
    "    'client_path': {" \
    "        'telnet': '/usr/bin/telnet'," \
    "    }" \
    "}" > ./config.py
RUN pip3 install --no-cache-dir --upgrade pip && pip3 install --no-cache-dir -r requirements.txt
CMD [ "python3.6", "app.py"]
