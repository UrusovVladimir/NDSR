# Образ frontend. Контекст сборки — {{ app_dir }} (см. .dockerignore там).
# Vite читает .env (его рендерит роль) во время npm run build.
FROM node:20.13.1-alpine3.20 AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
# Конфиг nginx монтируется из {{ build_dir }}/nginx.conf (см. ndsr-app.yml)
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
CMD ["nginx", "-g", "daemon off;"]
