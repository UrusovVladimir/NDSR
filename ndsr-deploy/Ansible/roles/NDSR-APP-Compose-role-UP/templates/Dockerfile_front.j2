# Образ frontend. Контекст сборки — {{ app_dir }} (см. .dockerignore там).
# Vite читает .env (его рендерит роль) во время npm run build.
# vite 7 требует Node >= 20.19; в npm из 20.13 ошибка «Exit handler never
# called» обрывает установку на медленной сети (иногда с кодом 0)
FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
# Проверка: без неё недоустановленные зависимости всплывали только как
# «vite: not found» на следующем шаге
RUN npm ci && test -x node_modules/.bin/vite
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
# Конфиг nginx монтируется из {{ build_dir }}/nginx.conf (см. ndsr-app.yml)
RUN rm -f /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
CMD ["nginx", "-g", "daemon off;"]
