# Сгенерировано Ansible (роль NDSR-APP-Compose-role-UP) — не редактировать на хосте.
# Передаётся контейнеру через env_file (в образ не попадает).
WS_PORT={{ ws_port }}

DEVICES_CONFIG_PATH={{ devices_path }}
WAN_TYPES_CONFIG_PATH={{ wan_type_path }}
USER_CONFIG_PATH={{ users_path }}
BADGES_CONFIG_PATH={{ badges_path }}
CURRENT_MODES_PATH={{ current_modes_path }}
BOOKINGS_PATH={{ bookings_path }}
MWS_LINKS_PATH={{ mws_links_path }}
VMS_CONFIG_PATH={{ vms_path }}
VM_ATTACHMENTS_PATH={{ vm_attachments_path }}
VM_TRUNK_IFACE={{ vm_trunk_iface }}
VM_RDP_IN_IFACE={{ vm_rdp_in_iface }}
VM_RDP_PUBLIC_HOST={{ vm_rdp_public_host }}
# RDP в браузере: пусто — выключено
GUACD_HOST={{ guacd_ip if browser_rdp_enabled | bool else '' }}
GUACD_PORT=4822
GUAC_WS_PORT={{ guac_ws_port }}
UPLOAD_DIR={{ upload_dir }}

STATUS_CHECK_INTERVAL={{ status_check_interval }}
STATUS_CHECK_TIMEOUT={{ status_check_timeout }}
DEBUG_WAN={{ debug_wan }}

# Файловый лог с ротацией (пусто — выключен, остаются только docker logs)
LOG_DIR={{ log_container_dir if log_host_dir else '' }}
LOG_MAX_SIZE_MB={{ log_max_size_mb }}
LOG_MAX_FILES={{ log_max_files }}

# true ТОЛЬКО если клиенты ходят через nginx с proxy_set_header X-Real-IP $remote_addr
# и порт бэкенда наружу не опубликован
TRUST_PROXY_HEADERS={{ trust_proxy_headers }}
VPN_IP_PREFIXES={{ vpn_ip_prefixes }}

MOXA_IPS={{ moxa_ips }}

JEROME_IPS={{ jerome_ips }}
JEROME_PORT={{ jerome_port }}

VES_LOGIN={{ login_ves }}
VES_PASSWORD={{ password_ves }}
VES_IP={{ ves_ip }}
VES_PORT={{ ves_port }}

SWITCH_IPs={{ switch_ips }}
SWITCH_WAN_IPs={{ switch_wan_ips }}
SWITCH_LOGIN={{ login_switch }}
SWITCH_PASSWORD={{ password_switch }}
SWITCH_PORT={{ switch_port }}

SSH_HOST={{ ssh_host }}
SSH_PORT={{ ssh_port }}
SSH_USERNAME={{ ssh_username }}
SSH_PRIVATE_KEY_PATH={{ ssh_key_container_path }}
