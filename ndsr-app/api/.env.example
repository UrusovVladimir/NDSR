WS_PORT=3000

DEVICES_CONFIG_PATH=./devices.json
WAN_TYPES_CONFIG_PATH=./wan_types.json
USER_CONFIG_PATH=./users.json
BADGES_CONFIG_PATH=./badge.json
STATUS_CHECK_INTERVAL=5
STATUS_CHECK_TIMEOUT=3
UPLOAD_DIR=./uploads
CURRENT_MODES_PATH=./current_modes.json
BOOKINGS_PATH=./bookings.json
MWS_LINKS_PATH=./mws_links.json
# Тестовые VM (пусто/нет файла — функция выключена), см. vms.example.json
VMS_CONFIG_PATH=./vms.json
VM_ATTACHMENTS_PATH=./vm_attachments.json
VM_TRUNK_IFACE=int
VM_RDP_IN_IFACE=internet
VM_RDP_PUBLIC_HOST=
# Только для разработки: адрес, с которого разрешить RDP (ваш VPN-IP), если
# dev-бэкенд видит браузер по другому адресу. В проде не задавать.
VM_RDP_SOURCE_OVERRIDE=
# RDP в браузере (Guacamole): пусто — выключено
GUACD_HOST=
GUACD_PORT=4822
GUAC_WS_PORT=3006
DEBUG_WAN=true

# Файловый лог с ротацией: пусто — только stdout
LOG_DIR=
LOG_MAX_SIZE_MB=10
LOG_MAX_FILES=5


# true ТОЛЬКО если стоит nginx с proxy_set_header X-Real-IP $remote_addr;
TRUST_PROXY_HEADERS=false
VPN_IP_PREFIXES=172.16.,192.168.5.
# Администраторы портала (Bulk Power / Reset в Device Management), IP через запятую
ADMIN_IPS=

MOXA_IPS=172.16.77.254:5005,172.16.77.254:5006

JEROME_IPS=172.16.77.252
JEROME_PORT=23
VES_LOGIN=nddr
VES_PASSWORD=
VES_IP=192.168.77.99
VES_PORT=23
SWITCH_IPs=192.168.77.114
SWITCH_WAN_IPs=192.168.77.220
SWITCH_LOGIN=nddr
SWITCH_PASSWORD=
SWITCH_PORT=23

SSH_HOST=
SSH_PORT=22
SSH_USERNAME=

SSH_PRIVATE_KEY_PATH=/path/to/private_key

# Защита от блокировки адреса портала Keenetic-ом (PROJECT.md 5.2):
# не больше AUTH_MAX_FAILS неверных паролей на устройство за AUTH_FAIL_WINDOW_MS
# AUTH_MAX_FAILS=2
# AUTH_FAIL_WINDOW_MS=900000
